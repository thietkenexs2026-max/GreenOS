    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Viết kịch bản xử lý các lỗi hay gặp khi khách mua hàng trên app</Data></Cell>
    <Cell ss:StyleID="PriorityTB"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Tính trước mấy trường hợp hết hàng đột xuất tại quầy, khách ngoài bán kính giao lạnh 5km hoặc bấm thanh toán 2 lần.</Data></Cell>
