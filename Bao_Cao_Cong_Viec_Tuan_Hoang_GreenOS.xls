   </Row>
   <Row ss:Height="44">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/11/02</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">02/11/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[Ver 1] Dựng khung giao diện Bảng điều khiển Kinh tế &amp; Lao động Cấp Xã (Actor 3 - UBND Xã Đồng Lam)</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Thiết kế bố cục 2 cột đồng bộ hệ sinh thái Green Village Ver 1: menu điều hướng cấp xã bên trái, đỉnh trang hiển thị thông tin lãnh đạo UBND xã và 4 thẻ KPI kinh tế nông thôn.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Khung giao diện Dashboard Cán bộ Xã Ver 1 | 📸 Xem ảnh thực tế: https://cho-xanh.vercel.app/output_images/12_ver1_dashboard_xa_tong_quan.png | 🔗 Web: https://cho-xanh.vercel.app/commune-dashboard.html</Data></Cell>
   </Row>
   <Row ss:Height="44">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/11/02</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">02/11/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[Ver 1] Tích hợp Cổng trình diễn 3 nền tảng (Portal) và bàn làm việc đối sánh Dual Studio Workbench</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Đấu nối liên thông đủ 3 phân hệ của Green Village Ver 1 (Mobile Bác Ba, Dashboard HTX Yên Bình, Dashboard Cán bộ Xã) trên cùng một cổng trình diễn phục vụ báo cáo.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Cổng trình diễn 3 nền tảng Green Village Ver 1 | 📸 Xem ảnh thực tế: https://cho-xanh.vercel.app/output_images/16_ver1_portal_3_nen_tang.png | 🔗 Portal: https://cho-xanh.vercel.app/portal.html</Data></Cell>
   </Row>
   <Row ss:Height="44">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/11/02</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">02/11/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[Ver 1] Đồng bộ phông chữ Lexend &amp; Inter kèm bảng màu Emerald chuẩn nhận diện giữa Dashboard Xã và HTX</Data></Cell>
    <Cell ss:StyleID="PriorityTB"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Chuẩn hóa bộ biến màu Emerald (#064E3B, #10B981) kết hợp phông chữ Lexend đậm rõ cho các con số thống kê sản lượng và ngân sách, đảm bảo đồng nhất toàn bản Ver 1.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Hệ thống Typography &amp; Bảng màu đồng bộ | 📸 Xem ảnh thực tế: https://cho-xanh.vercel.app/output_images/01_dashboard_htx_tong_quan.webp</Data></Cell>
   </Row>
   <Row ss:Height="44">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">4</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/11/03</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">03/11/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[Ver 1] Xây dựng phân hệ theo dõi hồ sơ OCOP (OCOP Pipeline) và Ma trận xếp hạng các HTX trong xã</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Hiển thị tiến độ thẩm định từng sản phẩm OCOP 3 sao - 4 sao của các thôn và bảng chấm điểm xếp hạng năng lực vận hành của các HTX nông nghiệp trên địa bàn.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Bảng OCOP Pipeline &amp; Ma trận xếp hạng HTX | 📸 Xem ảnh thực tế: https://cho-xanh.vercel.app/output_images/14_ver1_dashboard_xa_xep_hang_htx_ocop.png | 🔗 Web: https://cho-xanh.vercel.app/commune-dashboard.html</Data></Cell>
   </Row>
   <Row ss:Height="44">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">5</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/11/03</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">03/11/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[Ver 1] Lập trình tính năng Ký duyệt báo cáo điện tử và đóng dấu đỏ UBND Xã trực tiếp trên màn hình</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Làm cửa sổ xem trước công văn báo cáo tổng hợp kinh tế xã, tích hợp nút bấm ký số hiển thị con dấu đỏ chính thức của UBND xã và xuất biên bản nghiệm thu.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Luồng ký duyệt điện tử đóng dấu đỏ cấp xã | 📸 Xem ảnh thực tế: https://cho-xanh.vercel.app/output_images/15_ver1_dashboard_xa_ky_so_dong_dau_do.png</Data></Cell>
   </Row>
   <Row ss:Height="44">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">6</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/11/03</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">03/11/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[Ver 1] Tích hợp thư viện Chart.js vẽ biểu đồ tăng trưởng sản lượng và cơ cấu lao động nông thôn</Data></Cell>
    <Cell ss:StyleID="PriorityTB"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Vẽ biểu đồ cột và biểu đồ đường thể hiện sản lượng tiêu thụ nông sản qua các tháng của Green Village Ver 1, tự động co giãn mượt mà trên cả PC và iPad.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Biểu đồ Chart.js mức số hoá &amp; sản lượng mùa vụ | 📸 Xem ảnh thực tế: https://cho-xanh.vercel.app/output_images/13_ver1_dashboard_xa_bieu_do_chartjs.png</Data></Cell>
   </Row>
   <Row ss:Height="44">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">7</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/11/04</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">04/11/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[Ver 1] Thay thế toàn bộ ký tự Emoji rời rạc bằng hệ thống Icon SVG vector sắc nét trên toàn bộ Ver 1</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Thiết kế và gắn mới bộ icon SVG đồng nhất độ dày nét vẽ cho toàn bộ thanh menu, thẻ KPI, nút hành động và bảng xếp hạng trên Dashboard Xã và Cổng Portal.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">100% icon trên Dashboard Xã &amp; Portal chuyển sang SVG | 📸 Xem ảnh thực tế: https://cho-xanh.vercel.app/output_images/12_ver1_dashboard_xa_tong_quan.png</Data></Cell>
   </Row>
   <Row ss:Height="44">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">8</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/11/04</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">04/11/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[Ver 1] Lập trình bộ lọc phạm vi Thôn/Bản và Tháng báo cáo tự động cập nhật lại biểu đồ thời gian thực</Data></Cell>
    <Cell ss:StyleID="PriorityTB"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Khi cán bộ xã chọn từng thôn hoặc đổi tháng báo cáo trên thanh công cụ, toàn bộ thẻ KPI và biểu đồ Chart.js tự động tính toán và vẽ lại số liệu ngay lập tức.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Bộ lọc Thôn/Tháng phản hồi tức thì (Reactive Charts) | 📸 Xem ảnh thực tế: https://cho-xanh.vercel.app/output_images/13_ver1_dashboard_xa_bieu_do_chartjs.png</Data></Cell>
   </Row>
   <Row ss:Height="44">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">9</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/11/04</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">04/11/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[Ver 1] Làm cửa sổ Modal nhập số liệu thực tế tại cuộc họp cập nhật thẳng vào biểu đồ cấp xã</Data></Cell>
    <Cell ss:StyleID="PriorityTB"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Cho phép cán bộ nhập nhanh sản lượng thu hoạch mới hoặc số hộ tham gia ngay trong lúc họp giao ban, bấm lưu là biểu đồ trên màn hình chiếu nhảy số theo.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Modal nhập số liệu trực tiếp trên Dashboard Xã | 📸 Xem ảnh thực tế: https://cho-xanh.vercel.app/output_images/14_ver1_dashboard_xa_xep_hang_htx_ocop.png</Data></Cell>
   </Row>
   <Row ss:Height="44">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/11/05</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">05/11/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[Ver 1] Rà soát và kiểm thử chéo toàn bộ luồng liên thông 4 Actor của phiên bản Green Village Ver 1</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Kiểm tra sự ăn khớp số liệu giữa Mobile Bác Ba đăng bán chuối sấy -&gt; HTX Yên Bình duyệt đơn sỉ WinMart -&gt; Cổng B2B -&gt; Báo cáo tổng hợp tại UBND Xã.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Luồng dữ liệu 4 Actor của Ver 1 chạy thông suốt | 📸 Xem ảnh thực tế: https://cho-xanh.vercel.app/output_images/05_cong_b2b_dat_don_si.webp</Data></Cell>
   </Row>
   <Row ss:Height="44">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">11</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/11/05</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">05/11/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[Ver 1] Tối ưu giao diện Dual Studio Workbench (studio-10.html) đặt song song Mobile và Desktop</Data></Cell>
    <Cell ss:StyleID="PriorityTB"><Data ss:Type="String">Trong tuần</Data></Cell>
