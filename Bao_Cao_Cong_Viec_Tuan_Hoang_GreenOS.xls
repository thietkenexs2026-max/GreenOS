    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Lên khung mô hình chuỗi bán lẻ và sàn G-Xanh Từ Làng Ra Phố: gom hàng từ xã về tổng rồi bán qua cửa hàng và app.</Data></Cell>
