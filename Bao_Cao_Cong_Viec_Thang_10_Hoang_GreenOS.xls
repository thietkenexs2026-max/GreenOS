<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Center"/>
   <Borders/>
   <Font ss:FontName="Segoe UI" x:Family="Swiss" ss:Size="10" ss:Color="#000000"/>
   <Interior/>
   <NumberFormat/>
   <Protection/>
  </Style>
  <Style ss:ID="HeaderStyle">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
   </Borders>
   <Font ss:FontName="Segoe UI" x:Family="Swiss" ss:Size="10" ss:Color="#374151" ss:Bold="1"/>
   <Interior ss:Color="#F9FAFB" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="CellStyle">
   <Alignment ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
   </Borders>
   <Font ss:FontName="Segoe UI" x:Family="Swiss" ss:Size="9.5" ss:Color="#111827"/>
  </Style>
  <Style ss:ID="CenterCell">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
   </Borders>
   <Font ss:FontName="Segoe UI" x:Family="Swiss" ss:Size="9.5" ss:Color="#374151"/>
  </Style>
  <Style ss:ID="DoneStyle">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
   </Borders>
   <Font ss:FontName="Segoe UI" x:Family="Swiss" ss:Size="9.5" ss:Color="#03543F" ss:Bold="1"/>
   <Interior ss:Color="#DEF7EC" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="DoingStyle">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
   </Borders>
   <Font ss:FontName="Segoe UI" x:Family="Swiss" ss:Size="9.5" ss:Color="#92400E" ss:Bold="1"/>
   <Interior ss:Color="#FEF3C7" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="PriorityGap">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
   </Borders>
   <Font ss:FontName="Segoe UI" x:Family="Swiss" ss:Size="9.5" ss:Color="#9B1C1C" ss:Bold="1"/>
   <Interior ss:Color="#FDE8E8" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="PriorityCao">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
   </Borders>
   <Font ss:FontName="Segoe UI" x:Family="Swiss" ss:Size="9.5" ss:Color="#9A3412" ss:Bold="1"/>
   <Interior ss:Color="#FFEDD5" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="PriorityTB">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
   </Borders>
   <Font ss:FontName="Segoe UI" x:Family="Swiss" ss:Size="9.5" ss:Color="#3730A3"/>
   <Interior ss:Color="#E0E7FF" ss:Pattern="Solid"/>
  </Style>
 </Styles>
 <Worksheet ss:Name="BaoCaoThang10">
  <Table ss:ExpandedColumnCount="11" x:FullColumns="1" x:FullRows="1" ss:DefaultRowHeight="24">
   <Column ss:Width="45"/>
   <Column ss:Width="90"/>
   <Column ss:Width="75"/>
   <Column ss:Width="95"/>
   <Column ss:Width="105"/>
   <Column ss:Width="85"/>
   <Column ss:Width="105"/>
   <Column ss:Width="260"/>
   <Column ss:Width="85"/>
   <Column ss:Width="280"/>
   <Column ss:Width="300"/>
   <Row ss:Height="28">
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">STT</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Ngày (yyyy/mm/dd)</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Người làm</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Dự kiến hoàn thành</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Nexs/ Greenfi</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Tiến độ</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Nguồn</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Đầu việc</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Thứ tự ưu tiên</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Ghi chú</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Output/Tài liệu</Data></Cell>
   </Row>
   <Row ss:Height="40">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/01</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">01/10/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Dựng khung sườn Mobile App Bác Ba chuẩn màn hình điện thoại (390px)</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Chốt kích thước khung 390x844px theo mockup iPhone/Android, khóa tràn ngang (overflow-x: hidden) để bà con vuốt không bị xô lệch layout.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Khung sườn Mobile App Bác Ba chạy mượt, không vỡ layout | 📸 Xem ảnh thực tế: https://cho-xanh.vercel.app/output_images/06_mobile_bac_ba_trang_chu.webp | 🔗 Link web: https://cho-xanh.vercel.app/mobile</Data></Cell>
   </Row>
   <Row ss:Height="40">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/01</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">01/10/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Làm thanh điều hướng đáy (Bottom Bar) 5 tab cho bà con dễ bấm</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Làm 5 tab: Trang chủ, Đăng bán, Nhật ký, Đơn hàng, Tài khoản. Chỉnh icon to, chữ tiếng Việt rõ ràng, bấm tab nào sáng đèn tab đó.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Thanh Bottom Bar 5 tab bo góc dưới đáy màn hình | 📸 Xem ảnh: https://cho-xanh.vercel.app/output_images/06_mobile_bac_ba_trang_chu.webp</Data></Cell>
   </Row>
   <Row ss:Height="40">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/01</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">01/10/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Cài đặt bộ màu thương hiệu GreenFi và chọn cỡ chữ to cho người lớn tuổi</Data></Cell>
    <Cell ss:StyleID="PriorityTB"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Lấy màu xanh lá làm chủ đạo (#1B7A43), chữ dùng font Inter tăng lên 15-16px để các cô chú 50-60 tuổi nhìn rõ không bị mỏi mắt.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Bộ màu chuẩn GreenFi và font chữ to rõ toàn app | 📸 Xem ảnh thực tế: https://cho-xanh.vercel.app/output_images/06_mobile_bac_ba_trang_chu.webp | 🔗 Link web: https://cho-xanh.vercel.app/mobile</Data></Cell>
   </Row>
   <Row ss:Height="40">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">4</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/02</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">02/10/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Dựng 4 slide màn hình Chào mừng (Onboarding) giới thiệu cách dùng app</Data></Cell>
    <Cell ss:StyleID="PriorityTB"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Thay toàn bộ ảnh thanh niên cũ bằng bộ ảnh chú nông dân thật 45-50 tuổi đứng trong vườn, phủ lớp nền tối ở chân ảnh để chữ nổi bật.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">4 slide Onboarding chụp nông dân thật đứng vườn bưởi, chuối | 📸 Xem demo: https://cho-xanh.vercel.app/output_images/07_mobile_bac_ba_dark_mode.webp</Data></Cell>
   </Row>
   <Row ss:Height="40">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">5</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/02</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">02/10/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Làm hiệu ứng vuốt chạm chuyển slide Onboarding mượt mà</Data></Cell>
    <Cell ss:StyleID="PriorityTB"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Cho vuốt tay qua lại mượt, thêm mấy chấm tròn báo vị trí trang, dưới đáy có nút &#x27;Bỏ qua&#x27; và nút &#x27;Bắt đầu ngay&#x27; màu xanh.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Vuốt chạm chuyển slide trơn tru, bấm nút là vào thẳng trang chủ</Data></Cell>
   </Row>
   <Row ss:Height="40">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">6</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/02</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">02/10/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Lưu trạng thái đã xem Onboarding để lần sau vào không phải xem lại</Data></Cell>
    <Cell ss:StyleID="PriorityTB"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Ghi biến vào LocalStorage, bà con mở app từ lần thứ 2 là nhảy thẳng vào Trang chủ luôn cho đỡ sốt ruột.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Đã lưu cache trình duyệt, mở lại app vào thẳng trang chủ Bác Ba</Data></Cell>
   </Row>
   <Row ss:Height="40">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">7</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/02</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">02/10/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">WiseMeal</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Hỗ trợ Bảo tinh chỉnh và tối ưu luồng UI/UX Trang chủ ứng dụng Mealy</Data></Cell>
    <Cell ss:StyleID="PriorityTB"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Rà soát bố cục các khối món ngon gia đình, căn chỉnh khoảng cách các nút gạt chế độ nấu ăn và trải nghiệm lướt mâm cơm 3 món.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Giao diện Trang chủ Mealy mượt mà, đồng bộ luồng công thức nấu ăn cùng Bảo</Data></Cell>
   </Row>
   <Row ss:Height="40">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">8</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/05</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">05/10/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Lên giao diện Trang chủ Bác Ba với lời chào cá nhân hóa và khối việc cần làm</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Hiển thị câu chào &#x27;Chào Bác Ba! 👋 (Xã Yên Bình · HTX Đồng Cát)&#x27;, kèm thống kê đơn đã bán và nút chụp ảnh đăng bán to đùng.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Trang chủ Bác Ba có lời chào và widget việc cần làm | 📸 Xem ảnh thực tế: https://cho-xanh.vercel.app/output_images/06_mobile_bac_ba_trang_chu.webp</Data></Cell>
   </Row>
   <Row ss:Height="40">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">9</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/05</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">05/10/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Làm danh sách nông sản đang vào mùa vụ cuộn ngang (Carousel)</Data></Cell>
    <Cell ss:StyleID="PriorityTB"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Đưa các mặt hàng chủ lực của HTX lên trang chủ: Chuối sấy giòn Yên Bình, Trà Bát Tiên, Mật ong hoa rừng kèm nhãn OCOP và giá tham khảo.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Hàng nông sản cuộn ngang: Chuối sấy OCOP 4 sao, Trà Bát Tiên, Mật ong rừng | 📸 Xem ảnh: https://cho-xanh.vercel.app/output_images/06_mobile_bac_ba_trang_chu.webp</Data></Cell>
   </Row>
   <Row ss:Height="40">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/05</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">05/10/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">WiseMeal</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Họp review đánh giá phiên bản Ver 1 ứng dụng Mealy cùng Bảo và team</Data></Cell>
    <Cell ss:StyleID="PriorityTB"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Kiểm tra toàn bộ luồng tạo hộp thoại In-App, từ điển ẩm thực vùng miền và trải nghiệm lọc mâm cơm theo khẩu vị.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Biên bản nghiệm thu Ver 1 Mealy đạt chuẩn trải nghiệm, chốt danh sách tối ưu đợt tiếp theo</Data></Cell>
   </Row>
   <Row ss:Height="40">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">11</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/06</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">06/10/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Làm tính năng bấm máy ảnh chụp nông sản hoặc chọn ảnh từ máy</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Bấm 1 nút là mở camera điện thoại chụp ngay tại vườn, chụp xong có khung xem trước 4 góc: cận cảnh quả, cuống lá, bao bì.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Khung chụp ảnh nông sản 1:1 xem trước sắc nét | 📸 Ảnh mẫu chuối sấy: https://cho-xanh.vercel.app/output_images/03_modal_nghe_audio_nong_dan.webp</Data></Cell>
   </Row>
