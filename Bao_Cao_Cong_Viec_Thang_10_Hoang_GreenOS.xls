    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Giấu thanh cuộn ngang xấu xí trên các tab danh mục nông sản</Data></Cell>
    <Cell ss:StyleID="PriorityTB"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Ẩn vệt thanh cuộn màu xám thô kệch (scrollbar-width: none), để lại thao tác vuốt cảm ứng đa điểm mượt như lướt TikTok.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Thanh tab cuộn mượt mà không hiện vệt cuộn xấu trên điện thoại</Data></Cell>
