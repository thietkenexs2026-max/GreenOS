    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Ghép module AI tự động cắt ảnh vuông và xóa phông nền bẩn sau lưng</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Chụp ở vườn dính đất cát hay bụi cây thì AI tự tách sạch, đưa về ảnh nền trắng sáng bóng như chụp trong studio.</Data></Cell>
