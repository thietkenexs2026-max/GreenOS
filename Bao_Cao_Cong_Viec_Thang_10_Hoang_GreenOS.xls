    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Chống tràn mép thẻ sản phẩm (Cards &amp; Grids) khi tên nông sản quá dài</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Thêm thuộc tính min-width: 0 !important cho các ô chứa chữ, tên dài như &#x27;Chuối Ngự Tiêu Hồng Chín Cây Buồng 15-18kg&#x27; không làm phình card.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Các thẻ sản phẩm vuông vức, không bị xô lệch khi tên nông sản dài</Data></Cell>
   </Row>
   <Row ss:Height="40">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">60</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/27</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">27/10/2026</Data></Cell>
