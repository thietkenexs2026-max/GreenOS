    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Tiếp nhận phản hồi và chỉnh sửa slide kinh doanh cô Thủy</Data></Cell>
    <Cell ss:StyleID="PriorityCao"><Data ss:Type="String">Cao</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Cập nhật lại bố cục trang bìa, tinh chỉnh các mốc tiến độ triển khai và bổ sung phần thuyết minh mô hình sàn nông sản.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Bản sửa đổi slide kinh doanh theo góp ý của cô Thủy</Data></Cell>
   </Row>
   <Row ss:Height="40">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">30</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/13</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">13/10/2026</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">WiseMeal</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Tối ưu luồng Đi Chợ và phân chia phiên người dùng cho ứng dụng Mealy</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Tách bạch danh sách nguyên liệu cần mua, lược bỏ gia vị nước nêm để user tự thêm khi hết; chia phiên khách vãng lai và tài khoản, khóa tính năng làm tiệc &amp; chia sẻ danh sách đi chợ đối với khách chưa đăng nhập.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Luồng Đi Chợ Mealy thông minh, danh sách nguyên liệu tinh gọn và kiểm soát phân quyền khách chuẩn xác</Data></Cell>
   </Row>
