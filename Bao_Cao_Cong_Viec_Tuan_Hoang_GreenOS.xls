    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Vẽ sơ đồ tách 2 dòng tiền và chia 15 phân hệ chức năng</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Tách riêng tiền khách nạp thẻ mua hàng với tiền cổ đông góp vốn mở điểm, chia 234 tính năng ra 3 giai đoạn làm dần.</Data></Cell>
