    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Bật giả lập màn hình 375px và 390px kiểm tra từng nút bấm xem có bị tràn mép không, căn chỉnh lại lề hai bên cho vừa khít.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Hiển thị chuẩn đét trên cả màn hình nhỏ 375px, không lệch pixel nào</Data></Cell>
   </Row>
   <Row ss:Height="40">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">59</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/27</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">27/10/2026</Data></Cell>
