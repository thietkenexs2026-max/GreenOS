<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Center"/>
   <Borders/>
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="11" ss:Color="#000000"/>
   <Interior/>
   <NumberFormat/>
   <Protection/>
  </Style>
  <Style ss:ID="HeaderStyle">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#004D20"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#004D20"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#004D20"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#004D20"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Color="#FFFFFF" ss:Bold="1"/>
   <Interior ss:Color="#1B7A43" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="CellStyle">
   <Alignment ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#1E293B"/>
  </Style>
  <Style ss:ID="OutputStyle">
   <Alignment ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#0369A1" ss:Bold="0"/>
   <Interior ss:Color="#F0F9FF" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="DoneStyle">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#0F5132" ss:Bold="1"/>
   <Interior ss:Color="#D1E7DD" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="CenterCell">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#1E293B"/>
  </Style>
  <Style ss:ID="HourCell">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#0C5460" ss:Bold="1"/>
   <Interior ss:Color="#D1ECF1" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="PriorityGap">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#842029" ss:Bold="1"/>
   <Interior ss:Color="#F8D7DA" ss:Pattern="Solid"/>
  </Style>
 </Styles>
 <Worksheet ss:Name="Báo cáo T10 - Hoàng">
  <Table ss:DefaultRowHeight="24">
   <Column ss:Width="45"/>
   <Column ss:Width="85"/>
   <Column ss:Width="90"/>
   <Column ss:Width="100"/>
   <Column ss:Width="70"/>
   <Column ss:Width="95"/>
   <Column ss:Width="75"/>
   <Column ss:Width="110"/>
   <Column ss:Width="280"/>
   <Column ss:Width="90"/>
   <Column ss:Width="340"/>
   <Column ss:Width="380"/>
   <Row ss:Height="32">
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">STT</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Ngày&#10;(yyyy/mm/dd)</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Người làm</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Dự kiến hoàn thành</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Thời lượng&#10;(Giờ)</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Nexs/ Greenfi</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Tiến độ</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Nguồn</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Đầu việc</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Thứ tự ưu tiên</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Ghi chú</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Output / Mô tả thực tế</Data></Cell>
   </Row>
   <Row ss:Height="45">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/01</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">01/10/2026</Data></Cell>
    <Cell ss:StyleID="HourCell"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Thiết lập cấu trúc khung giao diện Mobile App Green OS (chuẩn viewport 375px - 430px, CSS reset chống vỡ layout)</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[3h] Khởi tạo layout viewport di động, chống tràn ngang màn hình, thiết lập cấu trúc container thích ứng mọi dòng smartphone</Data></Cell>
    <Cell ss:StyleID="OutputStyle"><Data ss:Type="String">Mô tả: Khung mobile chuẩn 390x844px, overflow-x: hidden, không vỡ layout khi xoay ngang | Ảnh: scratch/output_images/06_mobile_bac_ba_trang_chu.png | Link: https://cho-xanh.vercel.app/mobile</Data></Cell>
   </Row>
   <Row ss:Height="45">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/01</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">01/10/2026</Data></Cell>
    <Cell ss:StyleID="HourCell"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Xây dựng thanh điều hướng đáy (Bottom Navigation Bar) 5 tab chính</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[3h] Triển khai 5 tab: Trang chủ, Đăng bán, Nhật ký, Đơn hàng, Tài khoản; hiệu ứng active mượt mà và chống giật khi chuyển tab</Data></Cell>
    <Cell ss:StyleID="OutputStyle"><Data ss:Type="String">Mô tả: Bottom bar cố định đáy cao 64px, đổ bóng mờ, icon Lucide SVG sắc nét kèm nhãn tiếng Việt | Ảnh: scratch/output_images/06_mobile_bac_ba_trang_chu.png</Data></Cell>
   </Row>
   <Row ss:Height="45">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/01</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">01/10/2026</Data></Cell>
    <Cell ss:StyleID="HourCell"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Thiết lập hệ thống màu sắc nhận diện GreenFi &amp; font chữ chuẩn tiếng Việt</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[2h] Màu xanh lá chủ đạo (#1B7A43 / #22C55E), màu phụ cam vàng nông sản, cấu hình font chữ rõ ràng dễ đọc cho người lớn tuổi</Data></Cell>
    <Cell ss:StyleID="OutputStyle"><Data ss:Type="String">Mô tả: Bảng token màu: Primary Green (#1B7A43), Accent Amber (#F59E0B), Neutral Slate, font Inter 15px tương phản cao</Data></Cell>
   </Row>
   <Row ss:Height="45">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">4</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/02</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">02/10/2026</Data></Cell>
    <Cell ss:StyleID="HourCell"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Thiết kế màn hình Chào mừng (Welcome Splash Screen) &amp; Slider Onboarding 4 bước</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[3h] Xây dựng hình ảnh chú nông dân thời đại số 45-50 tuổi, thông điệp số hóa kinh tế xã, đăng bán nhanh, chợ xanh, tìm xe HTX</Data></Cell>
    <Cell ss:StyleID="OutputStyle"><Data ss:Type="String">Mô tả: Bộ 4 ảnh dọc 9:16 chụp chú nông dân thật, gradient đen mờ 40% đáy, typography trắng nổi bật</Data></Cell>
   </Row>
   <Row ss:Height="45">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">5</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/02</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">02/10/2026</Data></Cell>
    <Cell ss:StyleID="HourCell"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Xây dựng hiệu ứng trượt mượt mà giữa các slide Onboarding và nút điều hướng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[3h] Hỗ trợ vuốt chạm cảm ứng trên di động, hiển thị chấm tròn chỉ số trang (dots indicator), nút Bỏ qua và Bắt đầu ngay</Data></Cell>
    <Cell ss:StyleID="OutputStyle"><Data ss:Type="String">Mô tả: Carousel cảm ứng swipe touch, chấm chỉ trang active mở rộng 24px, nút CTA xanh lá bo góc 8px</Data></Cell>
   </Row>
   <Row ss:Height="45">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">6</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/02</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">02/10/2026</Data></Cell>
    <Cell ss:StyleID="HourCell"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Lưu trạng thái đã xem Onboarding vào LocalStorage trình duyệt</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[2h] Tránh việc người dùng phải xem lại màn giới thiệu trong các phiên đăng nhập kế tiếp</Data></Cell>
    <Cell ss:StyleID="OutputStyle"><Data ss:Type="String">Mô tả: Khóa gv_onboarding_seen=true, chuyển hướng tức thì vào Trang chủ từ lần truy cập thứ hai</Data></Cell>
   </Row>
   <Row ss:Height="45">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">7</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/05</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">05/10/2026</Data></Cell>
    <Cell ss:StyleID="HourCell"><Data ss:Type="Number">4</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Xây dựng màn hình Trang chủ Bác Ba: Widget lời chào cá nhân hóa &amp; Thẻ tóm tắt doanh thu</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[4h] Hiển thị lời chào thân thiện theo buổi (Sáng/Chiều), thống kê doanh thu ngày, số đơn cần giao, lối tắt chụp ảnh đăng bán 1-chạm</Data></Cell>
    <Cell ss:StyleID="OutputStyle"><Data ss:Type="String">Mô tả: Card lời chào Bác Ba, thẻ doanh thu 4.850.000đ, 3 đơn chờ giao, nút camera to 56px nổi bật | Ảnh: scratch/output_images/06_mobile_bac_ba_trang_chu.png</Data></Cell>
   </Row>
   <Row ss:Height="45">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">8</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/05</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">05/10/2026</Data></Cell>
    <Cell ss:StyleID="HourCell"><Data ss:Type="Number">4</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Thiết kế lưới hiển thị danh mục nông sản đang vào mùa vụ kèm giá tham khảo</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[4h] Hiển thị các loại trái cây, rau màu đang chính vụ kèm giá sàn thị trường giúp bà con không bị thương lái ép giá</Data></Cell>
    <Cell ss:StyleID="OutputStyle"><Data ss:Type="String">Mô tả: Card cuộn ngang: Bưởi da xanh (45k/kg), Cam sành Hàm Yên (32k/kg), Gạo nếp Tú Lệ (38k/kg) kèm nhãn OCOP</Data></Cell>
   </Row>
   <Row ss:Height="45">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">9</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/06</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">06/10/2026</Data></Cell>
    <Cell ss:StyleID="HourCell"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Xây dựng luồng Đăng bán Bước 1: Chụp ảnh trực tiếp từ camera hoặc tải ảnh từ thư viện</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[3h] Tối ưu luồng truy cập camera mượt mà, hỗ trợ chụp nhiều góc của nông sản (toàn cảnh luống rau, cận cảnh quả)</Data></Cell>
    <Cell ss:StyleID="OutputStyle"><Data ss:Type="String">Mô tả: Khung chụp ảnh tỉ lệ 1:1, hỗ trợ preview 4 góc chụp: bao bì, mặt cắt quả, cận cảnh cuống lá</Data></Cell>
   </Row>
   <Row ss:Height="45">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">10</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/06</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">06/10/2026</Data></Cell>
    <Cell ss:StyleID="HourCell"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Tích hợp module AI Image Processing: Tự động crop vuông 1:1 và tách nền sạch</Data></Cell>
    <Cell ss:StyleID="PriorityGap"><Data ss:Type="String">Gấp</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">[3h] AI tự động loại bỏ hậu cảnh lộn xộn, chuyển nông sản về ảnh nền trắng sáng chuyên nghiệp chuẩn sàn thương mại điện tử</Data></Cell>
    <Cell ss:StyleID="OutputStyle"><Data ss:Type="String">Mô tả: Ảnh nông sản tách nền trắng studio, giữ nguyên độ bóng và cuống lá tươi, dung lượng tối ưu 85KB</Data></Cell>
   </Row>
   <Row ss:Height="45">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">11</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026/10/06</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Hoàng</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">06/10/2026</Data></Cell>
    <Cell ss:StyleID="HourCell"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Green Village</Data></Cell>
    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
