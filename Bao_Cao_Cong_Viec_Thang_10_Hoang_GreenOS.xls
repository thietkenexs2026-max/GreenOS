    <Cell ss:StyleID="PriorityTB"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Ai thích dùng nền tối thì hệ thống tự nhớ, lần sau mở lên vẫn giữ nguyên giao diện tối không bị nhảy về nền sáng.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Ghi nhớ chế độ Dark Mode tự động theo thói quen người dùng</Data></Cell>
