    <Cell ss:StyleID="DoneStyle"><Data ss:Type="String">Done</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Vinh và BLĐ</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Kẹp dòng tiêu đề sản phẩm tối đa 2 dòng, phần xuất xứ kẹp 1 dòng</Data></Cell>
    <Cell ss:StyleID="PriorityTB"><Data ss:Type="String">Trong tuần</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Dùng lệnh kẹp dòng (-webkit-line-clamp: 2), tên dài tự động ngắt dòng gọn gàng, giữ chiều cao các thẻ sản phẩm đều tăm tắp.</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Thẻ sản phẩm đều hàng thẳng lối, chữ dài tự động hiện dấu ba chấm</Data></Cell>
   </Row>
   <Row ss:Height="40">
